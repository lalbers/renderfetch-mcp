# renderfetch-mcp configuration. Copy to .env and fill in the secrets:
#   cp .env.example .env

# --- network / identity -----------------------------------------------------
# Listen port INSIDE the container. Compose/Quadlet map the host port to 8080,
# so keep this 8080 unless you also change the published port.
PORT=8080
BIND_HOST=0.0.0.0
# Your public origin (no trailing slash). Becomes the OAuth issuer and the
# canonical MCP resource URI (PUBLIC_BASE_URL + /mcp). Must equal the URL you
# paste into claude.ai.
PUBLIC_BASE_URL=https://mcp.example.com

# --- auth (REQUIRED) --------------------------------------------------------
# The single login that gates the consent screen. (Dynamic client registration
# registers the *client* — e.g. Claude; this protects the *user* approval step.)
AUTH_USERNAME=admin
# Replace placeholders; startup rejects example credentials. Password >=12 chars.
AUTH_PASSWORD=change-me-to-a-long-passphrase
# HMAC secret for signing access + consent tokens (>=32 chars).
#   openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48
# Optional static bearer token (>=32 chars) for headless/automation clients (claude.ai does
# NOT use it). Leave empty to disable that path.  openssl rand -base64 32
STATIC_BEARER_TOKEN=
# Set true to disable the static-bearer path entirely (OAuth only).
OAUTH_ONLY=false
# Extra exact redirect URIs to allow during registration (comma-separated).
# claude.ai's callback and loopback are always allowed; usually leave empty.
EXTRA_REDIRECT_URIS=
# Additional exact browser MCP origins, e.g. http://localhost:6274 (no paths).
ALLOWED_ORIGINS=
# Exact trusted reverse-proxy IP/CIDR list. Empty: ignore forwarded client IPs.
# Use the actual source address seen inside your container, not a hop count.
TRUST_PROXY=

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=600
CONSENT_REQUEST_TTL=600
OAUTH_MAX_CLIENTS=1000
MCP_SESSION_TTL_MS=900000
MCP_MAX_SESSIONS=100
MCP_MAX_SESSIONS_PER_CLIENT=10

# --- prompt-injection filter ------------------------------------------------
# strict: block high/critical-risk content. lenient: weaker sanitize + annotate.
# Neither guarantees immunity to prompt injection. Enabled detector failures block.
FILTER_MODE=strict
# Opt-in ML tier (needs the defender peer deps onnxruntime-node +
# @huggingface/transformers). The regex layers are always on; leave false.
FILTER_TIER2=false

# --- fetch / browser --------------------------------------------------------
NAV_TIMEOUT_MS=30000
DEFAULT_WAIT_MS=0
BROWSER_CONCURRENCY=4
BROWSER_MAX_QUEUE=16
FETCH_TIMEOUT_MS=90000
FETCH_MAX_REQUESTS=300
FETCH_MAX_HTML_BYTES=2000000
FETCH_MAX_TRANSFER_BYTES=20000000
FETCH_ALLOWED_PORTS=80,443
BROWSER_RECYCLE_AFTER=200
# Explicit container-only opt-out (code default is sandbox enabled).
# Shared-UID unsandboxed Chromium is NOT isolated from OAuth secrets. See SECURITY.md.
CHROMIUM_NO_SANDBOX=true
MAX_CHARS_DEFAULT=50000
# Optional: override the browser User-Agent sent to fetched pages.
# FETCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/Safari renderfetch-mcp
# SSRF guard: keep false to refuse private/loopback/link-local/metadata targets.
FETCH_ALLOW_PRIVATE=false
# Optional, token-expensive screenshot tool.
SCREENSHOT_ENABLED=false

# --- store / logging --------------------------------------------------------
DB_PATH=/data/renderfetch.db
LOG_LEVEL=info

# --- per-identity rate limit (applied to /mcp after auth) ----------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
