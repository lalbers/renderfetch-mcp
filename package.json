{
  "name": "renderfetch-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted remote MCP server: headless-browser web fetch with OAuth 2.1 and prompt-injection filtering.",
  "license": "MIT",
  "author": "Leon Albers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-connector",
    "web-fetch",
    "playwright",
    "headless-browser",
    "oauth",
    "prompt-injection",
    "podman"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "0.6.0",
    "@stackone/defender": "0.7.0",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jose": "^5.9.6",
    "jsdom": "^25.0.1",
    "p-limit": "^6.2.0",
    "pino": "^9.6.0",
    "playwright": "1.60.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
