{
  "name": "renderfetch-mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted remote MCP server: headless-browser web fetch with OAuth 2.1 and prompt-injection filtering.",
  "license": "MIT",
  "author": "Leon Albers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-connector",
    "web-fetch",
    "playwright",
    "headless-browser",
    "oauth",
    "prompt-injection",
    "podman"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "@stackone/defender": "0.9.4",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "playwright": "1.64.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
